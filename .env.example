# Progetto Supabase RUI (ruipubblico IVASS)
# Copia questo file in .env e inserisci la password del database.
# .env e' in .gitignore e non viene mai committato.

# Password del database Postgres.
# Supabase Dashboard > Project Settings > Database > Database password.
SUPABASE_DB_PASSWORD=

# Reference del progetto Supabase.
SUPABASE_PROJECT_REF=mahynindhrtridzmzfft

# Modalita' di connessione:
#   direct  connessione diretta a db.<ref>.supabase.co:5432 (richiede IPv6, supporta COPY)
#   pooler  connessione via pooler in session mode (IPv4, porta 5432)
SUPABASE_DB_MODE=direct

# Regione del pooler, usata solo con SUPABASE_DB_MODE=pooler.
SUPABASE_REGION=eu-west-1

# In alternativa a tutto quanto sopra, incolla la connection string completa.
# Se valorizzata, ha la precedenza.
DATABASE_URL=

# Data API: usata da `npm run import:rest` se non hai la password Postgres.
# La service role non va committata ne' esposta al browser.
SUPABASE_URL=https://mahynindhrtridzmzfft.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Geocoding sedi azienda (non committare la chiave).
GOOGLE_MAPS_API_KEY=

# Chiave per software esterni su /v1. La dashboard non la usa.
RUI_API_KEY=

# Unico operatore admin per /login. Non committare i valori veri.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Kimi (Moonshot) per l'approfondimento AI in Query. Non committare la chiave.
# https://platform.moonshot.ai/  oppure  https://platform.kimi.ai/
MOONSHOT_API_KEY=
# Opzionali: KIMI_BASE_URL=https://api.moonshot.ai/v1
#            KIMI_MODEL=kimi-k2.5

