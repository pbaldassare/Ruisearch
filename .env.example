# Ruisearch: configurazione locale (API di sviluppo, import da terminale, script).
# Copia questo file in .env. .env e' in .gitignore e non viene mai committato.
#
# ATTENZIONE: il database e' UNO SOLO, quello di produzione (progetto Supabase
# moyfkdwsghidkcifesrg, schema ruisearch). Non esiste un database di prova:
# utenti, chiavi API, password e aggiornamenti del registro fatti in locale
# valgono subito anche online, per tutti.

# --- Database ---------------------------------------------------------------

# Password del database Postgres (utente postgres).
# Supabase Dashboard > Project Settings > Database > Database password.
SUPABASE_DB_PASSWORD=

# Reference del progetto Supabase.
SUPABASE_PROJECT_REF=moyfkdwsghidkcifesrg

# Modalita' di connessione:
#   direct  connessione diretta a db.<ref>.supabase.co:5432 (richiede IPv6, supporta COPY)
#   pooler  connessione via pooler in session mode (IPv4, porta 5432)
SUPABASE_DB_MODE=direct

# Regione e cluster del pooler, usati solo con SUPABASE_DB_MODE=pooler.
# Il progetto sta in eu-central-1; aws-1 per i progetti recenti, aws-0 per i vecchi.
SUPABASE_REGION=eu-central-1
SUPABASE_POOLER_CLUSTER=aws-1

# Schema Postgres con le tabelle di Ruisearch (progetto Supabase condiviso con altre app).
DB_SCHEMA=ruisearch

# In alternativa a tutto quanto sopra, la connection string completa: se
# valorizzata ha la precedenza. Online (Edge Function) e' l'unica usata, col
# ruolo dedicato ruisearch_api; su GitHub Actions e' il secret del workflow.
DATABASE_URL=

# Opzionali, per il pool di connessioni (valori predefiniti fra parentesi):
#   DB_POOL_MAX               connessioni al massimo (4)
#   DB_POOL_IDLE_MS           chiusura delle connessioni inattive (180000; 30000 sulla Edge)
#   DB_STATEMENT_TIMEOUT_MS   limite di una query (30000)
#   DB_LOCK_TIMEOUT_MS        attesa massima di un lock, es. durante l'import (3000)

# --- Accesso -----------------------------------------------------------------

# Firma dei token di sessione (almeno 32 caratteri casuali). Generala con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Online va impostata anche come segreto della Edge Function su Supabase.
SESSION_SECRET=

# Unico operatore admin per /login. Non committare i valori veri.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Le password dei clienti sono casuali (create e reimpostate dalla pagina Utenti): niente default.

# Chiave fissa per software esterni su /v1, in aggiunta a quelle generate dalla
# pagina Documentazione. Facoltativa: se vuota, /v1 accetta solo le chiavi generate.
RUI_API_KEY=

# --- Servizi esterni ----------------------------------------------------------

# Google Maps per la mappa delle sedi e il geocoding (non committare la chiave).
GOOGLE_MAPS_API_KEY=

# Kimi (Moonshot) per Query e per i recapiti Opportunity (web, LinkedIn, social). Non committare la chiave.
# https://platform.moonshot.ai/  oppure  https://platform.kimi.ai/
MOONSHOT_API_KEY=
# Opzionali: KIMI_BASE_URL=https://api.moonshot.ai/v1
#            KIMI_MODEL=kimi-k2.6

# --- Solo online: segreti della Edge Function su Supabase ----------------------
# Non servono in locale (in locale l'aggiornamento gira dentro `npm run api`).
#   GITHUB_TOKEN  token GitHub con permesso "Actions: write" sul repository: il
#                 pulsante "Aggiorna ora" avvia il workflow. Se manca, la pagina
#                 rimanda al workflow su GitHub.
#   GITHUB_REPO   repository del workflow (predefinito pbaldassare/Ruisearch).

# --- API locale ----------------------------------------------------------------

# Server di sviluppo (`npm run api`, usato da `npm run dev`): ascolta solo su
# questo computer, Vite gli inoltra /api.
RUI_API_HOST=127.0.0.1
RUI_API_PORT=8787
