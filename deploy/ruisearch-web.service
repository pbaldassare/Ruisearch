[Unit]
Description=Ruisearch web (static + proxy /api)
After=network-online.target ruisearch-api.service
Wants=network-online.target
Requires=ruisearch-api.service

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/cursor projects/ruisearch
Environment=RUI_WEB_HOST=0.0.0.0
Environment=RUI_WEB_PORT=80
Environment=RUI_API_URL=http://127.0.0.1:8787
ExecStart=/usr/local/bin/node scripts/serve-web.js
Restart=always
RestartSec=3
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
